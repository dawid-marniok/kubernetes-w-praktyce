    {
      "id": 15,
      "type": "timeseries",
      "title": "Żądania /s po trasie",
      "description": "Metryki liczone przez Tempo ze spanów serwera todos-api-<namespace>. Bez trace'ów: No data",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"todos-api-$namespace\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"GET /api/health\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
