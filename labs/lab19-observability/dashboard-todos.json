      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=\"web\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=\"web\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
