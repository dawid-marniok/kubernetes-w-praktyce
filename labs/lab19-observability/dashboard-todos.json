    {
      "id": 17,
      "type": "timeseries",
      "title": "Czas odpowiedzi p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"todos-api-$namespace\", span_kind=\"SPAN_KIND_SERVER\", span_name!=\"GET /api/health\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "instant": false,
