# Szablon przetwarzany przy starcie kontenera przez entrypoint obrazu nginx:
# /etc/nginx/templates/*.template --envsubst--> /etc/nginx/conf.d/*
# ${API_HOST} i ${API_PORT} to zmienne środowiskowe kontenera (domyślne w Dockerfile).
server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # API: /api/... -> http://api:3001/api/... (ścieżka bez zmian)
    location /api/ {
        proxy_pass         http://${API_HOST}:${API_PORT};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # SPA: nieznane ścieżki obsługuje index.html (routing po stronie Reacta)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
